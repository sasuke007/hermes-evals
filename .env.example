# Copy to .env. Compose and local development both read it. Never committed.
#
# Provider credentials are read by the egress service only. They never enter
# a trial container: each trial gets a per-attempt token for egress's model
# gateway instead, and the worker's LLM judge calls go through egress's admin
# socket. After changing one, apply it with `docker compose up -d egress worker`.
#
# Nous Portal uses an OAuth login, not a key: connect it in the web app under
# System > Model access > Connect. The login lives in the nous-home volume,
# which only nous-login and nous-proxy mount.
#
# Or, for development, reuse the login of the Hermes installed on this machine
# without copying it: run `hermes proxy start --provider nous` on the host and
# set the line below. Egress then forwards Nous calls to that proxy, and
# Model access shows Nous as "host". Any container in the Docker VM can reach
# a host loopback service, so use this only on a machine you trust.
# NOUS_HOST_PROXY=host.docker.internal:8645
OPENROUTER_API_KEY=
# NOUS_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional key egress sends to a `custom` configuration's own base URL.
# CUSTOM_API_KEY=

# MCP server secrets: values for the env names a server definition lists.
# A stdio server's names are read from the worker's environment (and the
# agent can read them); an http server's header variables (for example
# VENDOR_API_TOKEN=...) from egress's, which adds them in its MCP gateway.
# A header pair may give a prefix (for example `Bearer `), which egress writes
# before the value, so the variable holds the raw key; without one egress
# sends the value as the whole header. Both apply after `docker compose up -d
# egress worker`. Launch answers 409 while a chosen configuration's server
# names a variable that is not set where it is read.
# Only names reach the database and the UI. A definition may not name a
# provider key or a platform variable (DATABASE_URL, HOME, DOCKER_*, ...):
# those never enter a trial. The sample stdio server baked into the trial
# image reads its invoices from this file:
INVOICE_DB_URL=file:///opt/mcp/invoice-db/invoices.csv

# The sample http MCP server vendor-directory (profile `samples`:
# `docker compose --profile samples up -d`) requires this token. Egress adds
# it to each request as `Authorization: Bearer <token>` (its definition gives
# the prefix `Bearer `, which egress writes), so it never enters a run, and
# the api and worker get it blanked. Any random string works for the sample,
# e.g. the output of `openssl rand -hex 16`. Apply with
# `docker compose --profile samples up -d egress vendor-directory`.
VENDOR_DIRECTORY_TOKEN=

# The scripted mock model (profile `test`): a scripts file, or a directory of
# *.json files read in name order, that Compose mounts into the mock;
# ./scripts gives it every smoke test's and suite's scripts. MOCK_SCRIPTS adds
# short overrides, played first (apps/egress/src/mock-scripts.ts).
# MOCK_SCRIPTS_FILE=./scripts
# MOCK_SCRIPTS=[{"match":"<phrase>","steps":[{"content":"..."}]}]

# LLM judge for llm_judge checks (unset by default). A check's own `model:`
# wins and runs on JUDGE_PROVIDER (nous when unset). Launch and Re-score
# answer 409 for a task whose llm_judge check has no model from either, and
# while the judge's provider is not ready. Apply with
# `docker compose up -d api worker`.
# JUDGE_PROVIDER=nous
# JUDGE_MODEL=openai/gpt-6.1-sol
# Only with JUDGE_PROVIDER=custom, e.g. the scripted mock model:
# JUDGE_BASE_URL=http://mock-model:8090/v1

# Total tokens the model gateway serves one attempt before it answers 402
# (read by egress and the worker; apply with `docker compose up -d egress worker`).
# A run stopped there ends as an execution error (`limit`), not retried automatically.
# MODEL_TOKEN_CAP_PER_ATTEMPT=2000000

# Local development only (Compose sets these per service):
DATABASE_URL=postgres://hermes:hermes@localhost:5432/hermes_evals
PORT=3000
LOG_LEVEL=info
# Trials one worker runs at once; capped at the number of TRIAL_SLOTS.
WORKER_CONCURRENCY=3
CORS_ORIGIN=http://localhost:5173
# Host names the API answers besides localhost, 127.0.0.1, api and the host of
# CORS_ORIGIN (comma-separated); any other Host is refused.
# ALLOWED_HOSTS=
# The nous-login service the api and worker ask (Compose sets it).
# NOUS_LOGIN_URL=http://nous-login:8650
# Never set HERMES_PORTAL_BASE_URL or NOUS_PORTAL_BASE_URL for the stack:
# they exist only to point tests at a fake portal.

# Execution settings, shown with their defaults:
# MAX_CONSECUTIVE_EXECUTION_ERRORS=14   # execution errors in a row that fail an experiment
# TRIAL_RETENTION_DAYS=7                # days a finished trial's workspace is kept
# RECOVERY_INTERVAL_MS=15000            # how often each worker runs recovery
# LEASE_SECONDS=60                      # an attempt's lease; renewed every 10 s
