# Copy to .env. Compose and local development both read it. Never committed.
#
# Provider credentials are read by the egress service (and the worker, for the
# LLM judge) only. They never enter a trial container: each trial gets a
# per-attempt token for egress's model gateway instead.
#
# Nous Portal uses an OAuth login, not a key. Log in once, into the nous-proxy
# service's own volume:
#   docker compose --profile nous run --rm nous-proxy auth add nous --type oauth --no-browser
#
# Or, for development, reuse the login of the Hermes installed on this machine
# without copying it: run `hermes proxy start --provider nous` on the host and
# set the line below. Egress then forwards Nous calls to that proxy. Any
# container in the Docker VM can reach a host loopback service, so use this
# only on a machine you trust.
# NOUS_HOST_PROXY=host.docker.internal:8645
OPENROUTER_API_KEY=

# MCP server secrets: values for the env names a server definition lists.
# A stdio server's names are read from the worker's environment (and the
# agent can read them); an http server's header variables from egress's.
# Only names reach the database and the UI. A definition may not name a
# provider key or a platform variable (DATABASE_URL, HOME, DOCKER_*, ...):
# those never enter a trial. The sample stdio server baked into the trial
# image reads its invoices from this file:
INVOICE_DB_URL=file:///opt/mcp/invoice-db/invoices.csv

# Local development only (Compose sets these per service):
DATABASE_URL=postgres://hermes:hermes@localhost:5432/hermes_evals
PORT=3000
LOG_LEVEL=info
WORKER_CONCURRENCY=3
CORS_ORIGIN=http://localhost:5173
# Host names the API answers besides localhost, 127.0.0.1, api and the host of
# CORS_ORIGIN (comma-separated); any other Host is refused.
# ALLOWED_HOSTS=
