{
  "name": "@hermes-evals/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Domain types, task schemas and API contracts shared by the API, worker and web app",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "oxlint": "~1.82.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11"
  }
}
