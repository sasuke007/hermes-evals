{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/suites/**"],
      "env": ["RUN_SANDBOX_TESTS", "DOCKER_SOCKET", "TRIALS_DIR", "TRIAL_IMAGE", "TRIAL_VOLUME"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["TEST_DATABASE_URL"]
    },
    "db:generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:check": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
